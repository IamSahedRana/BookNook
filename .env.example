# Copy this file to .env.local and fill in the values.
MONGODB_URI=
DB_NAME=booknook

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_IMGBB_KEY=

# false = use the real Express server (keep false in production). true = built-in demo books, no server needed.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Optional: only change this if you point uploads at a different image service
# NEXT_PUBLIC_IMGBB_API_URL=https://api.imgbb.com/1/upload
